# Pocket Foundry configuration
# Copy to ~/.synthia-foundry/config.env

INBOX_DIR=/sdcard/Download/SynthiaInbox
WORK_ROOT=$HOME/.synthia-foundry
POLL_SECONDS=20
MAX_PROMPT_CHARS=70000
MAX_ZIP_FILES=3000
MAX_ZIP_BYTES=536870912

# Existing Synthia server. Change if you host it elsewhere.
SYNTHIA_SERVER_URL=https://synthia-server.onrender.com
SYNTHIA_SERVER_TOKEN=

# Model route used by the background worker.
# "trident" posts to /trident/generate.
MODEL_MODE=trident

# Optional local fallback. The command receives the build prompt on stdin
# and must print the model response on stdout.
DEV_AGENT_CMD=

# Build behavior
ALLOW_INSTALL=1
RUN_TESTS=1
MAX_AGENT_ATTEMPTS=2

# Optional remote reporting
QUEUE_TO_SYNTHIA=1
DEVICE_ID=android-pocket-foundry
